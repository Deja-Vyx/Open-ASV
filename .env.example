# Copy to .env and adjust.
ZAP_API_KEY=change-me
# OPENASV_PORT=9100

# Protect the UI and API (recommended when anyone else can reach the host)
# OPENASV_ADMIN_PASSWORD=
# OPENASV_API_TOKEN=

# Organisation running the scans (report section A.2)
# OPENASV_SCANNER_COMPANY=Example Security Team
# OPENASV_SCANNER_CONTACT=Jane Doe
# OPENASV_SCANNER_EMAIL=security@example.com
# OPENASV_SCANNER_WEBSITE=https://example.com

# NVD API key for faster version-based CVE correlation (https://nvd.nist.gov/developers/request-an-api-key)
# OPENASV_NVD_API_KEY=
# OPENASV_NVD=1

# Notifications: Slack / Teams / generic JSON webhook
# OPENASV_WEBHOOK_URL=
# OPENASV_BASE_URL=http://localhost:9100

# Nuclei out-of-band (interactsh) testing; off by default for privacy
# OPENASV_NUCLEI_INTERACTSH=0
# OPENASV_SSH_AUDIT=ssh-audit
# OPENASV_WAFW00F=wafw00f
